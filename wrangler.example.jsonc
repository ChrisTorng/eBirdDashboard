{
  "name": "ebird-dashboard",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-11-26",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "birds.example.com/api/*",
      "zone_name": "example.com"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ebird-dashboard",
      "database_id": "REPLACE_WITH_OWN_D1_UUID",
      "migrations_dir": "worker/migrations"
    }
  ],
  "vars": {
    "APP_HOST": "birds.example.com",
    "ACCESS_ISSUER": "https://YOUR_TEAM.cloudflareaccess.com",
    "ACCESS_AUD": "REPLACE_WITH_OWN_ACCESS_APPLICATION_AUD"
  }
}